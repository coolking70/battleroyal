{
  "name": "zone-battle-royale",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "description": "区域式大逃杀网页游戏原型（单人单机 / 确定性种子）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "simulate": "tsx tools/simulateBalance.ts",
    "simulate:balance": "tsx tools/simulateBalance.ts",
    "audit:save": "tsx tools/auditSaveValidation.ts",
    "scripted:playthroughs": "tsx tools/scriptedPlaythroughs.ts",
    "audit:deps": "tsx tools/auditDependencies.ts",
    "art:doctor": "tsx tools/art/cli.ts doctor",
    "art:prompt": "tsx tools/art/cli.ts prompt",
    "art:prompt-audit": "tsx tools/art/cli.ts prompt-audit",
    "art:generate": "tsx tools/art/cli.ts generate",
    "art:event-e1": "tsx tools/art/cli.ts event-e1",
    "art:injured-batch": "tsx tools/art/cli.ts injured-batch",
    "art:combat-batch": "tsx tools/art/cli.ts combat-batch",
    "art:list": "tsx tools/art/cli.ts list",
    "art:approve": "tsx tools/art/cli.ts approve",
    "art:reject": "tsx tools/art/cli.ts reject",
    "art:publish": "tsx tools/art/cli.ts publish",
    "art:validate": "tsx tools/art/cli.ts validate",
    "art:api-check": "tsx tools/art/cli.ts api-check",
    "art:smoke": "tsx tools/art/cli.ts smoke",
    "art:review-export": "tsx tools/art/reviewExport.ts",
    "art:security": "npm run art:security:browser && npm run art:security:repo",
    "art:security:browser": "tsx tools/art/securityAudit.ts",
    "art:security:repo": "tsx tools/art/securityRepoAudit.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
